apiVersion: apps/v1
kind: Deployment
metadata:
  name: mongodb-kubernetes-operator
  namespace: mongodb
  labels:
    app.kubernetes.io/name: mongodb-kubernetes-operator
    app.kubernetes.io/component: controller
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: mongodb-kubernetes-operator
  template:
    metadata:
      labels:
        app.kubernetes.io/name: mongodb-kubernetes-operator
    spec:
      serviceAccountName: mongodb-kubernetes-operator
      containers:
        - name: mongodb-kubernetes-operator
          image: quay.io/mongodb/mongodb-kubernetes-operator:0.7.8
          imagePullPolicy: IfNotPresent
          command:
            - /manager
          args:
            - "--leader-elect"
          env:
            - name: OPERATOR_NAME
              value: mongodb-kubernetes-operator
            - name: WATCH_NAMESPACE
              value: ""
            - name: POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: POD_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace

            # --- Community + Enterprise CRDs ---
            - name: MDB_OPERATOR_FEATURE_FLAGS
              value: "community,enterprise"

            # --- Telemetry ---
            - name: MONGODB_OPERATOR_TELEMETRY_ENABLED
              value: "true"

            # --- Related images (used by operator internally) ---
            - name: RELATED_IMAGE_MONGODB_4_4
              value: quay.io/mongodb/mongodb-enterprise-server:4.4
            - name: RELATED_IMAGE_MONGODB_5_0
              value: quay.io/mongodb/mongodb-enterprise-server:5.0
            - name: RELATED_IMAGE_MONGODB_6_0
              value: quay.io/mongodb/mongodb-enterprise-server:6.0

            - name: RELATED_IMAGE_MONGODB_AGENT
              value: quay.io/mongodb/mongodb-agent:12.0.16.7660-1

          resources:
            limits:
              cpu: "500m"
              memory: "512Mi"
            requests:
              cpu: "200m"
              memory: "256Mi"
